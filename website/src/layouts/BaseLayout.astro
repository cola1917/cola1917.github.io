---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import {
  languageTags,
  localeCopy,
  localeFromPath,
  pathForLocale,
  type Locale,
} from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  locale?: Locale;
  languagePath?: string;
  translationPaths?: Partial<Record<Locale, string>>;
  structuredData?: Record<string, unknown>;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const {
  description = site.description[locale],
  noindex = false,
  languagePath = Astro.url.pathname,
  structuredData,
} = Astro.props;
const title = Astro.props.title
  ? `${Astro.props.title} · ${site.name}`
  : `${site.name} — ${site.title[locale]}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const translationPaths = Astro.props.translationPaths ?? {
  en: pathForLocale(languagePath, 'en'),
  zh: pathForLocale(languagePath, 'zh'),
};
const toSiteUrl = (path: string) => Astro.site ? new URL(path, Astro.site) : new URL(path, Astro.url);
const englishUrl = translationPaths.en ? toSiteUrl(translationPaths.en) : undefined;
const chineseUrl = translationPaths.zh ? toSiteUrl(translationPaths.zh) : undefined;
const copy = localeCopy[locale];
---

<!doctype html>
<html lang={languageTags[locale]} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {!noindex && chineseUrl && <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />}
    {!noindex && chineseUrl && <link rel="alternate" hreflang="x-default" href={chineseUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={locale === 'zh' ? '工程笔记 RSS' : 'Engineering Notes RSS'}
      href={pathForLocale('/rss.xml', locale)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-default.png', canonical)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.title[locale]} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      />
    )}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          // Storage unavailable; fall back to the OS preference.
        }
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = saved === 'dark' || saved === 'light' ? saved : preferred;
        document.documentElement.dataset.theme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#10120f' : '#f5f3ed');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <Header locale={locale} languagePath={languagePath} translationPaths={translationPaths} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

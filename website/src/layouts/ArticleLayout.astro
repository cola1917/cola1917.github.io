---
import BaseLayout from './BaseLayout.astro';
import { categoryLabels, type CategorySlug } from '../data/site';
import { formatDate, slugify } from '../lib/content';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: CategorySlug;
  tags: string[];
}

const { title, description, publishedAt, updatedAt, category, tags } = Astro.props;
---

<BaseLayout title={`${title} — Jiangtao Wang`} description={description}>
  <article data-pagefind-body>
    <header class="article-header narrow">
      <div class="article-meta">
        <a href={`/categories/${category}/`}>{categoryLabels[category]}</a>
        <span aria-hidden="true">/</span>
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && <span>Updated {formatDate(updatedAt)}</span>}
      </div>
      <h1 class="article-title" data-pagefind-meta="title">{title}</h1>
      <p class="article-lede" data-pagefind-meta="description">{description}</p>
      <div class="article-tags">
        {tags.map((tag) => <a class="tag" href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}
      </div>
    </header>
    <div class="article-body">
      <div class="narrow prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

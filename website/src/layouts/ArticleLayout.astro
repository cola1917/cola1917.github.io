---
import BaseLayout from './BaseLayout.astro';
import { formatDate, slugify } from '../lib/content';
import { localeCopy, localizedPath, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  locale?: Locale;
  translationPaths?: Partial<Record<Locale, string>>;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  tags,
  locale = 'zh',
  translationPaths,
  structuredData,
} = Astro.props;
const copy = localeCopy[locale];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  translationPaths={translationPaths}
  structuredData={structuredData}
>
  <article data-pagefind-body>
    <header class="article-header narrow">
      <div class="article-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, locale)}</time>
        {updatedAt && <span>{copy.updated} {formatDate(updatedAt, locale)}</span>}
      </div>
      <h1 class="article-title" data-pagefind-meta="title">{title}</h1>
      <p class="article-lede" data-pagefind-meta="description">{description}</p>
      <div class="article-tags">
        {tags.map((tag) => <a class="tag" href={localizedPath(locale, `/tags/${slugify(tag)}/`)}>{tag}</a>)}
      </div>
    </header>
    <div class="article-body">
      <div class="narrow prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

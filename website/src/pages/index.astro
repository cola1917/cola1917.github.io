---
import { getCollection } from 'astro:content';
import NewsItem from '../components/NewsItem.astro';
import PostListItem from '../components/PostListItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished, sortNews, sortProjects } from '../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh')).sort(sortByPublished);
const news = (await getCollection('news')).filter(isPublished).filter(isLocale('zh')).sort(sortNews);
const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('zh')).sort(sortProjects);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
---

<BaseLayout locale="zh">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">自动驾驶仿真 · 系统评测 · 数据挖掘</p>
        <h1 class="display-title">
          把复杂系统，拆成<span class="accent">可验证的问题。</span>
        </h1>
        <p class="hero-copy">
          我主要做自动驾驶仿真、系统评测和数据分析：从真实数据里找问题，在仿真中复现问题，再用可重复的指标验证改动。
        </p>
        <div class="button-row">
          {posts.length > 0 ? (
            <a class="button" href="/blog/">阅读文章 <span aria-hidden="true">→</span></a>
          ) : (
            <a class="button" href="/about/">了解更多 <span aria-hidden="true">→</span></a>
          )}
          {projects.length > 0 && <a class="button secondary" href="/work/">查看项目</a>}
        </div>
      </div>

      <aside class="focus-panel" aria-label="当前关注">
        <h2>当前关注 / 2026</h2>
        <ol class="focus-list">
          <li><span>01</span>闭环仿真与场景复现</li>
          <li><span>02</span>系统级评测与回归</li>
          <li><span>03</span>长尾场景与数据分析</li>
        </ol>
      </aside>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeader
          title="最新文章"
          description="关于自动驾驶仿真、系统评测与数据分析的工程记录。"
          href="/blog/"
          linkLabel="全部文章 →"
        />
        <div class="list-stack editorial-list">
          {posts.slice(0, 3).map((post) => <PostListItem post={post} locale="zh" />)}
        </div>
      </div>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeader
          title="项目案例"
          description="整理问题、关键决策和经过验证的结果。"
          href="/work/"
          linkLabel="全部项目 →"
        />
        <div class="content-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} locale="zh" />)}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section section-compact">
      <div class="shell">
        <SectionHeader
          title="最新动态"
          description="站点、写作和项目的简短更新。"
          href="/news/"
          linkLabel="全部动态 →"
        />
        <div class="list-stack">
          {news.slice(0, 4).map((item) => <NewsItem item={item} locale="zh" />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../content/projects';
---

<MainLayout>
  <Hero />

  <!-- Projects Section -->
  <section id="projects" class="py-16 border-t border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-8">
        <p class="text-xs font-mono text-muted uppercase tracking-wider">Projects</p>
        <h2 class="mt-2 text-2xl font-sans font-bold">Infrastructure Systems</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            tags={project.tags}
            cta={project.cta}
            link={project.link}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 border-t border-border">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-xs font-mono text-muted">
        © {new Date().getFullYear()} Jiangtao Wang. All rights reserved.
      </p>
    </div>
  </footer>
</MainLayout>

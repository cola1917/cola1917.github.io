---
import { getCollection } from 'astro:content';
import NewsItem from '../components/NewsItem.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished, sortNews, sortProjects } from '../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh')).sort(sortByPublished);
const news = (await getCollection('news')).filter(isPublished).filter(isLocale('zh')).sort(sortNews);
const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('zh')).sort(sortProjects);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
---

<BaseLayout locale="zh">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">自动驾驶仿真 · 系统评测 · 数据挖掘</p>
        <h1 class="display-title">
          把复杂系统，拆成<span class="accent">可验证的问题。</span>
        </h1>
        <p class="hero-copy">
          我主要做自动驾驶仿真、系统评测和数据分析：从真实数据里找问题，在仿真中复现问题，再用可重复的指标验证改动。
        </p>
        <div class="button-row">
          <a class="button" href="/blog/">阅读文章 <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="/work/">查看项目</a>
        </div>
      </div>

      <aside class="focus-panel" aria-label="当前关注">
        <h2>当前关注 / 2026</h2>
        <ol class="focus-list">
          <li><span>01</span>闭环仿真与场景复现</li>
          <li><span>02</span>系统级评测与回归</li>
          <li><span>03</span>长尾场景与数据分析</li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="文章"
        title="最近写作"
        description="记录问题怎么拆、方案怎么做，以及结论如何被验证。"
        href="/blog/"
        linkLabel="查看全部 →"
      />
      {posts.length > 0 ? (
        <div class="content-grid">
          {posts.slice(0, 3).map((post) => <PostCard post={post} locale="zh" />)}
        </div>
      ) : (
        <div class="empty-state">还没有正式发布的文章。</div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="项目"
        title="项目实践"
        description="这里只整理能够说明问题、决策与结果的项目。"
        href="/work/"
        linkLabel="查看全部 →"
      />
      {featuredProjects.length > 0 ? (
        <div class="content-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} locale="zh" />)}
        </div>
      ) : (
        <div class="empty-state">项目案例暂未公开。</div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="动态"
        title="最近更新"
        description="记录站点、写作和项目的最新进展。"
        href="/news/"
        linkLabel="查看全部 →"
      />
      <div class="list-stack">
        {news.slice(0, 4).map((item) => <NewsItem item={item} locale="zh" />)}
      </div>
    </div>
  </section>
</BaseLayout>

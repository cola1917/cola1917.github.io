---
import { getCollection } from 'astro:content';
import NewsItem from '../components/NewsItem.astro';
import PostListItem from '../components/PostListItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished, sortNews, sortProjects } from '../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh')).sort(sortByPublished);
const news = (await getCollection('news')).filter(isPublished).filter(isLocale('zh')).sort(sortNews);
const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('zh')).sort(sortProjects);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
---

<BaseLayout locale="zh">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-intro">
        <p class="eyebrow">自动驾驶仿真工程师</p>
        <h1 class="display-title display-title-zh">
          <span class="display-line">从真实数据出发，</span>
          <span class="display-line">构建可验证的</span>
          <span class="display-line accent">仿真闭环。</span>
        </h1>
        <p class="hero-copy">
          聚焦闭环仿真、系统级评测与长尾场景挖掘，让问题发现、复现和回归验证成为一条<span class="no-break">可重复的工程流程。</span>
        </p>
        <div class="button-row hero-actions">
          <a class="button" href="/about/">查看专业档案 <span aria-hidden="true">→</span></a>
        </div>
        <ol class="hero-loop" aria-label="工作闭环">
          <li>
            <span>01</span>
            <strong>发现问题</strong>
            <small>真实数据与长尾场景</small>
          </li>
          <li>
            <span>02</span>
            <strong>仿真复现</strong>
            <small>回放、场景与闭环系统</small>
          </li>
          <li>
            <span>03</span>
            <strong>指标验证</strong>
            <small>系统评测与持续回归</small>
          </li>
        </ol>
      </div>

      <figure class="hero-portrait">
        <div class="portrait-media">
          <img
            src="/portrait.webp"
            alt="王江涛"
            width="720"
            height="720"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <span class="portrait-pixels" aria-hidden="true"><i></i><i></i><i></i></span>
      </figure>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeader
          title="博客"
          href="/blog/"
          linkLabel="查看全部 →"
        />
        <div class="list-stack editorial-list">
          {posts.slice(0, 3).map((post) => <PostListItem post={post} locale="zh" />)}
        </div>
      </div>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeader
          title="项目"
          href="/work/"
          linkLabel="查看全部 →"
        />
        <div class="content-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} locale="zh" />)}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section section-compact">
      <div class="shell">
        <SectionHeader
          title="动态"
          href="/news/"
          linkLabel="查看全部 →"
        />
        <div class="list-stack">
          {news.slice(0, 4).map((item) => <NewsItem item={item} locale="zh" />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<MainLayout>
  <Hero />

  <!-- Projects Section -->
  <section id="projects" class="py-10">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-6">
        <p class="text-xs font-mono text-muted uppercase tracking-wider">Projects</p>
        <h2 class="mt-1.5 text-xl font-sans font-bold">项目经历</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            link={`/projects/${project.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-4">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-xs font-mono text-muted">
        © {new Date().getFullYear()} Jiangtao Wang. All rights reserved.
      </p>
    </div>
  </footer>
</MainLayout>

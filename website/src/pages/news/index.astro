---
import { getCollection } from 'astro:content';
import NewsItem from '../../components/NewsItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortNews } from '../../lib/content';

const items = (await getCollection('news')).filter(isPublished).filter(isLocale('zh')).sort(sortNews);
---

<BaseLayout locale="zh" title="动态｜近期更新" description="网站、文章和项目的简短更新。">
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">动态</h1>
  </header>
  <section class="section" data-pagefind-body>
    <div class="shell list-stack">
      {items.length > 0 ? items.map((item) => <NewsItem item={item} locale="zh" />) : <div class="empty-state">暂时没有动态。</div>}
    </div>
  </section>
</BaseLayout>

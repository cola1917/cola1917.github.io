---
import { getCollection } from 'astro:content';
import { categoryLabels } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished } from '../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh'));
---

<BaseLayout locale="zh" title="分类｜博客" description="按主题浏览文章。">
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">分类</h1>
  </header>
  <section class="section">
    <div class="shell content-grid">
      {Object.entries(categoryLabels.zh).map(([slug, label]) => (
        <article class="card">
          <a class="card-link" href={`/categories/${slug}/`}>
            <span class="card-meta">{posts.filter((post) => post.data.category === slug).length} 篇笔记</span>
            <h2 class="card-title">{label}</h2>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

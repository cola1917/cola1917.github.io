---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import { categoryLabels } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh')).sort(sortByPublished);
  return Object.entries(categoryLabels.zh).map(([category, label]) => ({
    params: { category },
    props: {
      label,
      posts: posts.filter((post) => post.data.category === category),
    },
  }));
}

interface Props {
  label: string;
  posts: CollectionEntry<'blog'>[];
}

const { label, posts } = Astro.props;
---

<BaseLayout locale="zh" title={`${label}｜分类`} description={`${label}分类下的文章。`}>
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">{label}</h1>
    <p class="page-count">{posts.length} 篇文章</p>
  </header>
  <section class="section">
    <div class="shell">
      {posts.length > 0 ? (
        <div class="content-grid">{posts.map((post) => <PostCard post={post} locale="zh" headingLevel="h2" />)}</div>
      ) : (
        <div class="empty-state">这个分类还没有文章。</div>
      )}
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortProjects } from '../../lib/content';

const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('zh')).sort(sortProjects);
---

<BaseLayout locale="zh" title="项目" description="自动驾驶仿真、系统评测与数据分析相关的项目案例。">
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">项目</h1>
  </header>
  <section class="section">
    <div class="shell">
      {projects.length > 0 ? (
        <div class="content-grid">{projects.map((project) => <ProjectCard project={project} locale="zh" headingLevel="h2" />)}</div>
      ) : (
        <div class="empty-state">暂时没有公开的项目案例。</div>
      )}
    </div>
  </section>
</BaseLayout>

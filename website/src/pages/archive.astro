---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isPublished, sortByPublished } from '../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).sort(sortByPublished);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getUTCFullYear()))];
---

<BaseLayout title="Archive — Jiangtao Wang" description="All published engineering notes by year.">
  <header class="page-hero shell">
    <p class="eyebrow">Blog</p>
    <h1 class="page-title">Archive</h1>
    <p class="page-description">Every published note, newest first.</p>
  </header>
  <section class="section">
    <div class="shell">
      {years.map((year) => (
        <section>
          <h2>{year}</h2>
          <div class="list-stack">
            {posts.filter((post) => post.data.publishedAt.getUTCFullYear() === year).map((post) => (
              <a class="list-row" href={`/blog/${post.id}/`}>
                <time class="list-kicker" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                <span><strong class="list-title">{post.data.title}</strong><span class="list-summary">{post.data.description}</span></span>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished, slugify, sortByPublished } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished).sort(sortByPublished);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} — Jiangtao Wang`} description={`Engineering notes tagged ${tag}.`}>
  <header class="page-hero shell">
    <p class="eyebrow">Tag</p>
    <h1 class="page-title">#{tag}</h1>
    <p class="page-description">{posts.length} published {posts.length === 1 ? 'note' : 'notes'}.</p>
  </header>
  <section class="section">
    <div class="shell content-grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>
</BaseLayout>

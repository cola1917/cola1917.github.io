---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, slugify, sortByPublished } from '../../lib/content';
import type { Locale } from '../../lib/i18n';

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog')).filter(isPublished);
  const posts = allPosts.filter(isLocale('zh')).sort(sortByPublished);
  const englishSlugs = new Set(
    allPosts.filter(isLocale('en')).flatMap((post) => post.data.tags.map(slugify)),
  );
  // 按 slug 分组：不同写法但 slug 相同的 tag（如 "eval/metrics" 与 "eval metrics"）
  // 合并成一个页面，避免 getStaticPaths 产出重复 params 后被静默丢弃。
  const bySlug = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugify(tag);
      const group = bySlug.get(slug) ?? { tag, posts: [] };
      if (!group.posts.includes(post)) group.posts.push(post);
      bySlug.set(slug, group);
    }
  }
  return [...bySlug.entries()].map(([slug, group]) => ({
    params: { tag: slug },
    props: {
      tag: group.tag,
      posts: group.posts,
      translationPaths: {
        ...(englishSlugs.has(slug) ? { en: `/en/tags/${slug}/` } : {}),
        zh: `/tags/${slug}/`,
      },
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
  translationPaths: Partial<Record<Locale, string>>;
}

const { tag, posts, translationPaths } = Astro.props;
---

<BaseLayout
  locale="zh"
  title={tag}
  description={`带有 ${tag} 标签的文章。`}
  translationPaths={translationPaths}
>
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">{tag}</h1>
    <p class="page-count">{posts.length} 篇文章</p>
  </header>
  <section class="section">
    <div class="shell content-grid">{posts.map((post) => <PostCard post={post} locale="zh" headingLevel="h2" />)}</div>
  </section>
</BaseLayout>

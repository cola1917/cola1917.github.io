---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, slugify } from '../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh'));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout locale="zh" title="标签｜博客" description="按技术标签浏览文章。">
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">标签</h1>
  </header>
  <section class="section">
    <div class="shell">
      {tags.length > 0 ? (
        <div class="filters">
          {tags.map((tag) => (
            <a class="filter-link" href={`/tags/${slugify(tag)}/`}>
              #{tag}（{posts.filter((post) => post.data.tags.includes(tag)).length}）
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">还没有文章标签。</div>
      )}
    </div>
  </section>
</BaseLayout>

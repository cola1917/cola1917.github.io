---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished } from '../../../lib/content';
import { contentSlug, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const allProjects = (await getCollection('projects')).filter(isPublished);
  const projects = allProjects.filter(isLocale('en'));
  const chineseSlugs = new Set(allProjects.filter(isLocale('zh')).map((project) => contentSlug(project.id)));
  return projects.map((project) => {
    const slug = contentSlug(project.id);
    const translationPaths = {
      en: `/en/work/${slug}/`,
      ...(chineseSlugs.has(slug) ? { zh: `/work/${slug}/` } : {}),
    };
    return { params: { id: slug }, props: { project, translationPaths } };
  });
}

interface Props {
  project: CollectionEntry<'projects'>;
  translationPaths: Partial<Record<Locale, string>>;
}

const { project, translationPaths } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  translationPaths={translationPaths}
>
  <article data-pagefind-body>
    <header class="article-header shell">
      <div class="project-meta">
        <span class="status">{project.data.status}</span>
        <span>{project.data.timeframe ?? project.data.year}</span>
      </div>
      <h1 class="article-title" data-pagefind-meta="title">{project.data.title}</h1>
      <p class="article-lede" data-pagefind-meta="description">{project.data.description}</p>
      <dl class="project-facts" data-pagefind-ignore>
        <div class="project-fact">
          <dt>Role</dt>
          <dd>{project.data.role}</dd>
        </div>
        <div class="project-fact">
          <dt>Status</dt>
          <dd>{project.data.status}</dd>
        </div>
        <div class="project-fact">
          <dt>Stack</dt>
          <dd>{project.data.stack.join(' · ')}</dd>
        </div>
      </dl>
      {project.data.metrics.length > 0 && (
        <ul class="project-metrics" data-pagefind-ignore aria-label="Key results">
          {project.data.metrics.map((metric) => <li>{metric}</li>)}
        </ul>
      )}
      {project.data.links.length > 0 && (
        <div class="project-links-row" data-pagefind-ignore>
          {project.data.links.map((link) => (
            <a class="tag" href={link.url} rel="noopener" target="_blank">{link.label} ↗</a>
          ))}
        </div>
      )}
    </header>
    <div class="article-body">
      <div class="narrow prose"><Content /></div>
    </div>
  </article>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import ProjectCard from '../../../components/ProjectCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortProjects } from '../../../lib/content';

const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('en')).sort(sortProjects);
---

<BaseLayout
  title="Work | Engineering Case Studies"
  description="Engineering case studies in simulation, system evaluation, and scenario/data mining."
>
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">Work</h1>
  </header>
  <section class="section">
    <div class="shell">
      {projects.length > 0 ? (
        <div class="content-grid">{projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}</div>
      ) : (
        <div class="empty-state">Project case studies are being reviewed before publication.</div>
      )}
    </div>
  </section>
</BaseLayout>

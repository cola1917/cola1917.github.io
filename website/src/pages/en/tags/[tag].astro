---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, slugify, sortByPublished } from '../../../lib/content';
import type { Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog')).filter(isPublished);
  const posts = allPosts.filter(isLocale('en')).sort(sortByPublished);
  const chineseSlugs = new Set(
    allPosts.filter(isLocale('zh')).flatMap((post) => post.data.tags.map(slugify)),
  );
  // Group by slug so differently written tags that slugify identically share one page,
  // instead of producing duplicate params that Astro silently drops.
  const bySlug = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugify(tag);
      const group = bySlug.get(slug) ?? { tag, posts: [] };
      if (!group.posts.includes(post)) group.posts.push(post);
      bySlug.set(slug, group);
    }
  }
  return [...bySlug.entries()].map(([slug, group]) => ({
    params: { tag: slug },
    props: {
      tag: group.tag,
      posts: group.posts,
      translationPaths: {
        en: `/en/tags/${slug}/`,
        ...(chineseSlugs.has(slug) ? { zh: `/tags/${slug}/` } : {}),
      },
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
  translationPaths: Partial<Record<Locale, string>>;
}

const { tag, posts, translationPaths } = Astro.props;
---

<BaseLayout
  title={`#${tag}`}
  description={`Engineering notes tagged ${tag}.`}
  translationPaths={translationPaths}
>
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">#{tag}</h1>
    <p class="page-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
  </header>
  <section class="section">
    <div class="shell content-grid">{posts.map((post) => <PostCard post={post} headingLevel="h2" />)}</div>
  </section>
</BaseLayout>

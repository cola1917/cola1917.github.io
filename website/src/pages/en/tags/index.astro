---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, slugify } from '../../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('en'));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="Tags" description="Browse engineering notes by technical tag.">
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">Tags</h1>
  </header>
  <section class="section">
    <div class="shell filters">
      {tags.map((tag) => (
        <a class="filter-link" href={`/en/tags/${slugify(tag)}/`}>
          #{tag} ({posts.filter((post) => post.data.tags.includes(tag)).length})
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

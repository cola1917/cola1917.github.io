---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { isLocale, isPublished } from '../../../lib/content';
import { contentSlug, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog')).filter(isPublished);
  const posts = allPosts.filter(isLocale('en'));
  const chineseSlugs = new Set(allPosts.filter(isLocale('zh')).map((post) => contentSlug(post.id)));
  return posts.map((post) => {
    const slug = contentSlug(post.id);
    const translationPaths = {
      en: `/en/blog/${slug}/`,
      ...(chineseSlugs.has(slug) ? { zh: `/blog/${slug}/` } : {}),
    };
    return { params: { id: slug }, props: { post, translationPaths } };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  translationPaths: Partial<Record<Locale, string>>;
}

const { post, translationPaths } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Jiangtao Wang' },
  mainEntityOfPage: canonical,
};
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  locale="en"
  translationPaths={translationPaths}
  structuredData={postLd}
>
  <Content />
</ArticleLayout>

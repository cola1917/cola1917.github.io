---
import { getCollection } from 'astro:content';
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished } from '../../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('en')).sort(sortByPublished);
---

<BaseLayout
  title="Blog | Simulation, Evaluation & Data"
  description="Engineering notes on autonomous-driving simulation, evaluation, scenario mining, and data infrastructure."
>
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">Blog</h1>
  </header>

  <section class="section">
    <div class="shell">
      {posts.length > 0 ? (
        <div class="content-grid">
          {posts.map((post) => <PostCard post={post} headingLevel="h2" />)}
        </div>
      ) : (
        <div class="empty-state">No published notes yet.</div>
      )}

      <div class="button-row">
        <a class="button secondary" href="/en/archive/">Browse the archive</a>
        <a class="button secondary" href="/en/tags/">Browse tags</a>
        <a class="button secondary" href="/en/rss.xml">Subscribe via RSS</a>
      </div>
    </div>
  </section>
</BaseLayout>

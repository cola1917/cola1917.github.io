---
import { getCollection } from 'astro:content';
import NewsItem from '../../components/NewsItem.astro';
import PostListItem from '../../components/PostListItem.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished, sortNews, sortProjects } from '../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('en')).sort(sortByPublished);
const news = (await getCollection('news')).filter(isPublished).filter(isLocale('en')).sort(sortNews);
const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('en')).sort(sortProjects);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Simulation · Evaluation · Data Mining</p>
        <h1 class="display-title">
          Engineering reliable <span class="accent">evaluation loops.</span>
        </h1>
        <p class="hero-copy">
          I build and study the systems that turn driving data into reproducible scenarios,
          measurable behavior, and regression-ready evidence.
        </p>
        <div class="button-row">
          {posts.length > 0 ? (
            <a class="button" href="/en/blog/">Read the notes <span aria-hidden="true">→</span></a>
          ) : (
            <a class="button" href="/en/about/">Learn more <span aria-hidden="true">→</span></a>
          )}
          {projects.length > 0 && <a class="button secondary" href="/en/work/">Explore the work</a>}
        </div>
      </div>

      <aside class="focus-panel" aria-label="Current focus">
        <h2>Current focus / 2026</h2>
        <ol class="focus-list">
          <li><span>01</span>Simulation systems</li>
          <li><span>02</span>Evaluation infrastructure</li>
          <li><span>03</span>Scenario & data mining</li>
        </ol>
      </aside>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeader
          title="Latest writing"
          description="Engineering notes on simulation, system evaluation, and data analysis."
          href="/en/blog/"
          linkLabel="All writing →"
        />
        <div class="list-stack editorial-list">
          {posts.slice(0, 3).map((post) => <PostListItem post={post} />)}
        </div>
      </div>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeader
          title="Selected work"
          description="Problems, key decisions, and evidence from engineering practice."
          href="/en/work/"
          linkLabel="All work →"
        />
        <div class="content-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section section-compact">
      <div class="shell">
        <SectionHeader
          title="Latest updates"
          description="Short updates about the site, writing, and projects."
          href="/en/news/"
          linkLabel="All updates →"
        />
        <div class="list-stack">
          {news.slice(0, 4).map((item) => <NewsItem item={item} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

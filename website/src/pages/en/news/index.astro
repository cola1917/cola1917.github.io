---
import { getCollection } from 'astro:content';
import NewsItem from '../../../components/NewsItem.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortNews } from '../../../lib/content';

const items = (await getCollection('news')).filter(isPublished).filter(isLocale('en')).sort(sortNews);
---

<BaseLayout title="News | Recent Updates" description="Project, writing, release, and site updates.">
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">News</h1>
  </header>
  <section class="section" data-pagefind-body>
    <div class="shell list-stack">
      {items.length > 0 ? items.map((item) => <NewsItem item={item} />) : <div class="empty-state">No news yet.</div>}
    </div>
  </section>
</BaseLayout>

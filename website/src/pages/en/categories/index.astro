---
import { getCollection } from 'astro:content';
import { categoryLabels } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished } from '../../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('en'));
---

<BaseLayout title="Categories | Blog" description="Browse engineering notes by category.">
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">Categories</h1>
  </header>
  <section class="section">
    <div class="shell content-grid">
      {Object.entries(categoryLabels.en).map(([slug, label]) => (
        <article class="card">
          <a class="card-link" href={`/en/categories/${slug}/`}>
            <span class="card-meta">{posts.filter((post) => post.data.category === slug).length} notes</span>
            <h2 class="card-title">{label}</h2>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../../../components/PostCard.astro';
import { categoryLabels } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('en')).sort(sortByPublished);
  return Object.entries(categoryLabels.en).map(([category, label]) => ({
    params: { category },
    props: {
      label,
      posts: posts.filter((post) => post.data.category === category),
    },
  }));
}

interface Props {
  label: string;
  posts: CollectionEntry<'blog'>[];
}

const { label, posts } = Astro.props;
---

<BaseLayout title={`${label} | Category`} description={`Engineering notes filed under ${label}.`}>
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">{label}</h1>
    <p class="page-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
  </header>
  <section class="section">
    <div class="shell">
      {posts.length > 0 ? (
        <div class="content-grid">{posts.map((post) => <PostCard post={post} headingLevel="h2" />)}</div>
      ) : (
        <div class="empty-state">No published notes in this category yet.</div>
      )}
    </div>
  </section>
</BaseLayout>

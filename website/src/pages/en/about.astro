---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout title="About | Professional Profile" description="A professional profile focused on autonomous-driving simulation, evaluation, and data analysis.">
  <header class="about-hero shell">
    <p class="about-index" aria-hidden="true">PROFILE / 01</p>
    <div>
      <p class="eyebrow">Professional profile</p>
      <h1>About</h1>
      <p class="about-lede">
        My work sits in the validation layer of autonomous systems: turning road anomalies into replayable scenarios,
        comparable metrics, and regression workflows that can keep running.
      </p>
    </div>
  </header>

  <section class="about-body">
    <div class="shell about-grid" data-pagefind-body>
      <aside class="about-rail">
        <section>
          <h2>Focus</h2>
          <ul class="profile-list">
            <li>Closed-loop simulation and scenario reproduction</li>
            <li>System-level evaluation and regression</li>
            <li>Long-tail scenario and data mining</li>
          </ul>
        </section>
        <section>
          <h2>Contact</h2>
          <div class="contact-list">
            <a href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a>
            <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </aside>

      <div class="about-main">
        <section class="about-section">
          <span class="about-number" aria-hidden="true">01</span>
          <div>
            <h2>How I work</h2>
            <p>
              I usually start with anomalies or long-tail cases in driving data, define the problem boundary and
              reproduction conditions, rebuild the behavior through replay or closed-loop simulation, and validate
              the change with system-level metrics. The output is not only a conclusion, but reusable scenarios,
              metrics, and regression entry points.
            </p>
            <ol class="method-steps" aria-label="Working method">
              <li><span>01</span><strong>Discover</strong><small>Find a problem worth explaining</small></li>
              <li><span>02</span><strong>Define</strong><small>Set boundaries and conditions</small></li>
              <li><span>03</span><strong>Reproduce</strong><small>Replay or closed-loop simulation</small></li>
              <li><span>04</span><strong>Validate</strong><small>Metrics, comparison, regression</small></li>
            </ol>
          </div>
        </section>

        <section class="about-section">
          <span class="about-number" aria-hidden="true">02</span>
          <div>
            <h2>Published here</h2>
            <p>The site separates information by maturity: long-form methods, curated case studies, and lightweight updates.</p>
            <nav class="profile-links" aria-label="Published content">
              <a href="/en/blog/"><strong>Blog</strong><span>Methods, technical judgment, and reproduction notes</span><b aria-hidden="true">→</b></a>
              <a href="/en/work/"><strong>Work</strong><span>Problem boundaries, key decisions, and evidence</span><b aria-hidden="true">→</b></a>
              <a href="/en/news/"><strong>News</strong><span>Progress, releases, and site changes</span><b aria-hidden="true">→</b></a>
            </nav>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

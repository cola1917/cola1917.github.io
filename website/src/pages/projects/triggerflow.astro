---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="TriggerFlow | Jiangtao Wang">
  <main class="pt-14 min-h-screen">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <a href="/#projects" class="text-sm font-mono text-muted hover:text-black transition-colors">
        ← Back to Projects
      </a>

      <h1 class="mt-8 text-3xl font-sans font-bold">TriggerFlow</h1>
      <p class="mt-4 text-lg text-muted leading-relaxed">
        Replay-first risk scenario discovery platform for autonomous driving data closed-loop workflows.
      </p>

      <div class="mt-8 space-y-6">
        <section>
          <h2 class="text-lg font-sans font-semibold">Overview</h2>
          <p class="mt-2 text-muted leading-relaxed">
            TriggerFlow is a rule-based trigger mining engine designed for processing large-scale road test data.
            It abstracts long-tail risk scenarios into configurable rule chains, enabling automated discovery
            and extraction of high-value driving segments.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-sans font-semibold">Key Features</h2>
          <ul class="mt-2 space-y-2 text-muted">
            <li class="flex items-start gap-2">
              <span class="text-border">•</span>
              <span>Temporal constraint-based scenario detection</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-border">•</span>
              <span>Scene-level false positive filtering</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-border">•</span>
              <span>Versioned rule coverage mechanism (v1 ~ v8)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-border">•</span>
              <span>PNG/GIF visualization output</span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-lg font-sans font-semibold">Technology Stack</h2>
          <div class="mt-2 flex flex-wrap gap-2">
            {['Python', 'TFRecord', 'Rule-based Mining', 'Docker', 'CSV/JSON Pipeline'].map((tag) => (
              <span class="text-xs font-mono px-2 py-1 bg-surface border border-border rounded text-muted">
                {tag}
              </span>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</MainLayout>

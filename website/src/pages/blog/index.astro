---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished } from '../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh')).sort(sortByPublished);
---

<BaseLayout
  locale="zh"
  title="博客"
  description="关于自动驾驶仿真、系统评测、场景挖掘和数据工程的技术文章。"
>
  <header class="page-hero page-hero-compact shell">
    <h1 class="page-title">博客</h1>
  </header>

  <section class="section">
    <div class="shell">
      {posts.length > 0 ? (
        <div class="content-grid">
          {posts.map((post) => <PostCard post={post} locale="zh" headingLevel="h2" />)}
        </div>
      ) : (
        <div class="empty-state">还没有正式发布的文章。</div>
      )}

      <div class="button-row">
        <a class="button secondary" href="/archive/">浏览归档</a>
        <a class="button secondary" href="/tags/">浏览标签</a>
        <a class="button secondary" href="/rss.xml">订阅 RSS</a>
      </div>
    </div>
  </section>
</BaseLayout>

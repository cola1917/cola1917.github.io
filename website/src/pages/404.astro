---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="zh" title="404 — 页面不存在" description="没有找到请求的页面。" noindex languagePath="/">
  <section class="page-hero shell">
    <p class="eyebrow">404</p>
    <h1 class="page-title">这个页面不存在。</h1>
    <p class="page-description">链接可能已经失效，或者页面还没有发布。</p>
    <p class="page-description" lang="en">The page you requested doesn't exist — the link may be stale or unpublished.</p>
    <div class="button-row">
      <a class="button" href="/">返回首页</a>
      <a class="button secondary" href="/en/">English home</a>
      <a class="button secondary" href="/archive/">查看归档</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found" description="The requested page could not be found." noindex languagePath="/">
  <section class="page-hero shell">
    <p class="eyebrow">404</p>
    <h1 class="page-title">This route has no evidence.</h1>
    <p class="page-description">The page may have moved during the site reset.</p>
    <div class="button-row">
      <a class="button" href="/">Return home</a>
      <a class="button secondary" href="/archive/">Browse the archive</a>
    </div>
  </section>
</BaseLayout>

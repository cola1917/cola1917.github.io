---
import { getCollection } from 'astro:content';
import NewsItem from '../../components/NewsItem.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished, sortNews, sortProjects } from '../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh')).sort(sortByPublished);
const news = (await getCollection('news')).filter(isPublished).filter(isLocale('zh')).sort(sortNews);
const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('zh')).sort(sortProjects);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
---

<BaseLayout locale="zh">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">自动驾驶仿真 · 系统评测 · 数据挖掘</p>
        <h1 class="display-title">
          构建可靠的<span class="accent">评测闭环。</span>
        </h1>
        <p class="hero-copy">
          我关注如何把驾驶数据转化为可复现场景、可度量行为，以及能够进入回归流程的工程证据。
        </p>
        <div class="button-row">
          <a class="button" href="/zh/blog/">阅读笔记 <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="/zh/work/">查看作品</a>
        </div>
      </div>

      <aside class="focus-panel" aria-label="当前方向">
        <h2>当前方向 / 2026</h2>
        <ol class="focus-list">
          <li><span>01</span>仿真系统</li>
          <li><span>02</span>评测基础设施</li>
          <li><span>03</span>场景与数据挖掘</li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="写作"
        title="最新笔记"
        description="关于自动驾驶系统工作流的工程实践、实现决策与经验记录。"
        href="/zh/blog/"
        linkLabel="查看全部 →"
      />
      {posts.length > 0 ? (
        <div class="content-grid">
          {posts.slice(0, 3).map((post) => <PostCard post={post} locale="zh" />)}
        </div>
      ) : (
        <div class="empty-state">第一篇工程笔记正在准备中。</div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="作品集"
        title="代表性系统"
        description="案例会围绕问题、架构、权衡和证据展开，而不是简单罗列工具。"
        href="/zh/work/"
        linkLabel="查看全部 →"
      />
      {featuredProjects.length > 0 ? (
        <div class="content-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} locale="zh" />)}
        </div>
      ) : (
        <div class="empty-state">公开项目案例正在复核中。</div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="现在"
        title="最近动态"
        description="关于写作、项目、发布和阶段进展的简短更新。"
        href="/zh/news/"
        linkLabel="查看全部 →"
      />
      <div class="list-stack">
        {news.slice(0, 4).map((item) => <NewsItem item={item} locale="zh" />)}
      </div>
    </div>
  </section>
</BaseLayout>

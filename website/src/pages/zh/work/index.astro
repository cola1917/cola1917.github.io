---
import { getCollection } from 'astro:content';
import ProjectCard from '../../../components/ProjectCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortProjects } from '../../../lib/content';

const projects = (await getCollection('projects')).filter(isPublished).filter(isLocale('zh')).sort(sortProjects);
---

<BaseLayout locale="zh" title="作品 — 王江涛" description="关于仿真、系统评测和场景与数据挖掘的工程案例。">
  <header class="page-hero shell">
    <p class="eyebrow">作品集</p>
    <h1 class="page-title">展示系统，而不只是截图。</h1>
    <p class="page-description">
      从问题、职责、架构、权衡与证据几个方面记录代表性工程工作。
    </p>
  </header>
  <section class="section">
    <div class="shell">
      {projects.length > 0 ? (
        <div class="content-grid">{projects.map((project) => <ProjectCard project={project} locale="zh" />)}</div>
      ) : (
        <div class="empty-state">项目案例正在完成复核后再发布。</div>
      )}
    </div>
  </section>
</BaseLayout>

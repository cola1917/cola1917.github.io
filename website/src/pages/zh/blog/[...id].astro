---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { isLocale, isPublished } from '../../../lib/content';
import { contentSlug, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog')).filter(isPublished);
  const posts = allPosts.filter(isLocale('zh'));
  const englishSlugs = new Set(allPosts.filter(isLocale('en')).map((post) => contentSlug(post.id)));
  return posts.map((post) => {
    const slug = contentSlug(post.id);
    const translationPaths = {
      ...(englishSlugs.has(slug) ? { en: `/blog/${slug}/` } : {}),
      zh: `/zh/blog/${slug}/`,
    };
    return { params: { id: slug }, props: { post, translationPaths } };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  translationPaths: Partial<Record<Locale, string>>;
}

const { post, translationPaths } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  category={post.data.category}
  tags={post.data.tags}
  locale="zh"
  translationPaths={translationPaths}
>
  <Content />
</ArticleLayout>

---
import { getCollection } from 'astro:content';
import PostCard from '../../../components/PostCard.astro';
import { categoryLabels } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, isPublished, sortByPublished } from '../../../lib/content';

const posts = (await getCollection('blog')).filter(isPublished).filter(isLocale('zh')).sort(sortByPublished);
---

<BaseLayout
  locale="zh"
  title="博客 — 王江涛"
  description="关于自动驾驶仿真、评测、场景挖掘和数据基础设施的工程笔记。"
>
  <header class="page-hero shell">
    <p class="eyebrow">博客</p>
    <h1 class="page-title">来自系统层的工程笔记。</h1>
    <p class="page-description">
      记录仿真、评测、场景挖掘、数据基础设施，以及连接这些方向的工程决策。
    </p>
  </header>

  <section class="section">
    <div class="shell">
      <nav class="filters" aria-label="博客分类">
        <a class="filter-link active" href="/zh/blog/">全部（{posts.length}）</a>
        {Object.entries(categoryLabels.zh).map(([slug, label]) => {
          const count = posts.filter((post) => post.data.category === slug).length;
          return <a class="filter-link" href={`/zh/categories/${slug}/`}>{label}（{count}）</a>;
        })}
      </nav>

      {posts.length > 0 ? (
        <div class="content-grid">
          {posts.map((post) => <PostCard post={post} locale="zh" />)}
        </div>
      ) : (
        <div class="empty-state">暂时没有已发布的笔记。</div>
      )}

      <div class="button-row">
        <a class="button secondary" href="/zh/archive/">浏览归档</a>
        <a class="button secondary" href="/zh/rss.xml">订阅 RSS</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import { site } from '../data/site';
import { localeCopy, localeFromPath, pathForLocale, type Locale } from '../lib/i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale?: Locale;
  languagePath?: string;
  translationPaths?: Partial<Record<Locale, string>>;
}

const currentPath = Astro.url.pathname;
const locale = Astro.props.locale ?? localeFromPath(currentPath);
const languagePath = Astro.props.languagePath ?? currentPath;
const copy = localeCopy[locale];
const blogHref = pathForLocale('/blog/', locale);
const blogRoutes = ['/blog/', '/archive/', '/tags/'].map((path) => pathForLocale(path, locale));
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href === blogHref) return blogRoutes.some((path) => currentPath.startsWith(path));
  return currentPath.startsWith(href);
};
const translationPaths = Astro.props.translationPaths;
const englishPath = translationPaths ? translationPaths.en : pathForLocale(languagePath, 'en');
const chinesePath = translationPaths ? translationPaths.zh : pathForLocale(languagePath, 'zh');
const homeHref = pathForLocale('/', locale);
const isHome = currentPath === homeHref;
---

<header class="site-header" data-pagefind-ignore>
  <div class="shell header-inner">
    <a
      class="home-link"
      href={homeHref}
      aria-label={copy.home}
      aria-current={isHome ? 'page' : undefined}
    >
      <img class="home-mark" src="/favicon.svg" alt="" width="28" height="28" />
      <span>Home</span>
    </a>

    <nav class="primary-nav" aria-label={copy.primaryNavigation}>
      <ul class="nav-list">
        {site.nav[locale].map((item) => (
          <li>
            <a
              class="nav-link"
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-tools">
      <nav class="language-switcher" aria-label={copy.language}>
        {chinesePath ? (
          <a
            class:list={['language-option', { active: locale === 'zh' }]}
            href={chinesePath}
            lang="zh-CN"
            hreflang="zh-CN"
            aria-current={locale === 'zh' ? 'page' : undefined}
          >中文</a>
        ) : (
          <span class="language-option disabled" lang="zh-CN" aria-disabled="true">中文</span>
        )}
        {englishPath ? (
          <a
            class:list={['language-option', { active: locale === 'en' }]}
            href={englishPath}
            lang="en"
            hreflang="en"
            aria-current={locale === 'en' ? 'page' : undefined}
          >EN</a>
        ) : (
          <span class="language-option disabled" lang="en" aria-disabled="true">EN</span>
        )}
      </nav>
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

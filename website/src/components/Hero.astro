---
import { site } from '../content/site';
import ClosedLoopDiagram from './ClosedLoopDiagram.astro';
---

<section class="pt-14">
  <div class="max-w-6xl mx-auto px-6 pt-6 pb-4 w-full min-h-[calc(100vh-12rem)] flex items-start">
    <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-6 lg:gap-6 items-center w-full">

      <!-- Left: Profile -->
      <div class="space-y-6">
        <!-- Identity -->
        <div class="flex items-center gap-5">
          <div class="w-20 h-20 rounded-full bg-surface border border-border overflow-hidden flex-shrink-0">
            <img src="/Hero.astro.png" alt="Jiangtao Wang" class="w-full h-full object-cover" />
          </div>
          <div class="space-y-0.5">
            <h1 class="text-3xl font-sans font-bold tracking-tight">{site.name}</h1>
            <p class="text-sm font-mono text-muted">{site.nameEn}</p>
          </div>
        </div>

        <!-- Positioning -->
        <p class="text-sm font-mono text-muted/70 leading-relaxed">
          Autonomous Driving<br />
          Evaluation & Data Loop Infrastructure
        </p>

        <!-- Description -->
        <p class="text-sm text-muted/80 leading-relaxed max-w-sm">
          Building trigger mining, replay, evaluation, and regression workflows for autonomous driving closed-loop systems.
        </p>

        <!-- Current Focus -->
        <div class="space-y-1.5">
          <p class="text-[10px] font-mono text-muted uppercase tracking-[0.15em]">Current Focus</p>
          <p class="text-sm font-mono text-black">
            Trigger Mining · Scenario Replay · KPI Evaluation · Regression Validation
          </p>
        </div>

        <!-- Direction -->
        <div class="space-y-1.5">
          <p class="text-[10px] font-mono text-muted uppercase tracking-[0.15em]">Direction</p>
          <div class="text-sm font-mono text-muted space-y-0.5">
            <p>Evaluation Infrastructure</p>
            <p>Data Loop Platform</p>
            <p>Scenario Asset Workflow</p>
          </div>
        </div>
      </div>

      <!-- Right: Closed Loop Diagram -->
      <div class="flex justify-center">
        <ClosedLoopDiagram />
      </div>

    </div>
  </div>
</section>

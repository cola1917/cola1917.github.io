---
interface Props {
  title: string;
  description: string;
  link: string;
}

const { title, description, link } = Astro.props;
---

<a href={link} class="block border border-border rounded p-5 hover:border-black transition-colors group">
  <h3 class="font-sans font-semibold text-base">{title}</h3>

  <p class="mt-2 text-sm text-muted leading-relaxed">
    {description}
  </p>
</a>

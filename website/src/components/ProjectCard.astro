---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="card">
  <a class="card-link" href={`/work/${project.id}/`}>
    <div class="card-meta">
      <span>{project.data.year}</span>
      <span aria-hidden="true">/</span>
      <span>{project.data.role}</span>
    </div>
    <h3 class="card-title">{project.data.title}</h3>
    <p class="card-copy">{project.data.description}</p>
    <div class="card-foot">
      <span class="status">{project.data.status}</span>
      {project.data.stack.slice(0, 3).map((item) => <span class="tag">{item}</span>)}
    </div>
  </a>
</article>

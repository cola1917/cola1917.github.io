---
interface Props {
  title: string;
  description: string;
  tags: string[];
  cta: string;
  link: string;
}

const { title, description, tags, cta, link } = Astro.props;
---

<article class="border border-border rounded p-5 hover:border-black transition-colors group">
  <h3 class="font-sans font-semibold text-base">{title}</h3>

  <p class="mt-2 text-sm text-muted leading-relaxed">
    {description}
  </p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="text-xs font-mono px-2 py-0.5 bg-surface border border-border rounded text-muted">
        {tag}
      </span>
    ))}
  </div>

  <a
    href={link}
    class="inline-block mt-4 text-sm font-mono text-black group-hover:underline"
  >
    {cta}
  </a>
</article>

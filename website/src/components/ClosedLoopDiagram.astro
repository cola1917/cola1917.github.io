---
/**
 * ClosedLoopDiagram — Orbital Track Concept
 *
 * Circular closed-loop visualization for autonomous driving data pipeline.
 * - 4 focus nodes (highlighted): Trigger Mining, Scenario Replay, KPI Evaluation, Regression Validation
 * - 2 context nodes (lighter): Vehicle Logs (entry), Scenario Library (exit)
 * - Center label: "Continuous Data Loop"
 * - Subtle clockwise rotation animation on the track
 */
---

<div class="w-full max-w-md">
  <div class="relative" style="padding-bottom: 100%;">
    <svg
      viewBox="0 0 320 320"
      class="absolute inset-0 w-full h-full"
      xmlns="http://www.w3.org/2000/svg"
    >
      <style>
        .loop-track {
          animation: rotate 60s linear infinite;
          transform-origin: 160px 160px;
        }
        @keyframes rotate {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }
        .node-label {
          font-family: 'IBM Plex Mono', monospace;
          font-size: 9px;
          letter-spacing: 0.02em;
        }
        .center-label {
          font-family: 'Inter Tight', sans-serif;
          font-weight: 600;
          font-size: 12px;
        }
        .center-sub {
          font-family: 'IBM Plex Mono', monospace;
          font-size: 8px;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }
        .marker-arrow {
          fill: #8A8A88;
        }
        .marker-arrow-focus {
          fill: #000000;
        }
      </style>

      <!-- Definitions -->
      <defs>
        <!-- Focus arrow (black) -->
        <marker
          id="arrow-focus"
          viewBox="0 0 6 6"
          refX="5"
          refY="3"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 6 3 L 0 6 z" class="marker-arrow-focus" />
        </marker>

        <!-- Context arrow (gray) -->
        <marker
          id="arrow-ctx"
          viewBox="0 0 6 6"
          refX="5"
          refY="3"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 6 3 L 0 6 z" class="marker-arrow" />
        </marker>

        <!-- Focus glow filter -->
        <filter id="focus-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="2" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- ===== LAYER 1: Rotating track ring ===== -->
      <g class="loop-track">
        <!-- Outer ring (dashed, subtle) -->
        <circle
          cx="160"
          cy="160"
          r="128"
          fill="none"
          stroke="#E5E5E3"
          stroke-width="1"
          stroke-dasharray="4 3"
          opacity="0.5"
        />
        <!-- Inner ring (dashed, subtle) -->
        <circle
          cx="160"
          cy="160"
          r="92"
          fill="none"
          stroke="#E5E5E3"
          stroke-width="1"
          stroke-dasharray="4 3"
          opacity="0.5"
        />
      </g>

      <!-- ===== LAYER 2: Connection lines ===== -->
      <!-- Focus arc: Vehicle Logs → Trigger Mining (top-right, clockwise) -->
      <path
        d="M 196 60 A 110 110 0 0 1 260 124"
        fill="none"
        stroke="#000000"
        stroke-width="2"
        marker-end="url(#arrow-focus)"
      />

      <!-- Focus arc: Trigger Mining → Scenario Replay (right, clockwise) -->
      <path
        d="M 264 136 A 110 110 0 0 1 264 184"
        fill="none"
        stroke="#000000"
        stroke-width="2"
        marker-end="url(#arrow-focus)"
      />

      <!-- Focus arc: Scenario Replay → KPI Evaluation (bottom-right, clockwise) -->
      <path
        d="M 260 196 A 110 110 0 0 1 196 260"
        fill="none"
        stroke="#000000"
        stroke-width="2"
        marker-end="url(#arrow-focus)"
      />

      <!-- Focus arc: KPI Evaluation → Regression Validation (bottom, clockwise) -->
      <path
        d="M 184 264 A 110 110 0 0 1 136 264"
        fill="none"
        stroke="#000000"
        stroke-width="2"
        marker-end="url(#arrow-focus)"
      />

      <!-- Context arc: Regression Validation → Scenario Library (bottom-left, clockwise) -->
      <path
        d="M 124 260 A 110 110 0 0 1 60 196"
        fill="none"
        stroke="#8A8A88"
        stroke-width="1.5"
        stroke-dasharray="5 4"
        marker-end="url(#arrow-ctx)"
      />

      <!-- Context arc: Scenario Library → Vehicle Logs (top-left, clockwise) -->
      <path
        d="M 60 124 A 110 110 0 0 1 124 60"
        fill="none"
        stroke="#8A8A88"
        stroke-width="1.5"
        stroke-dasharray="5 4"
        marker-end="url(#arrow-ctx)"
      />

      <!-- ===== LAYER 3: Center label ===== -->
      <circle cx="160" cy="160" r="52" fill="#FAFAF8" />
      <circle
        cx="160"
        cy="160"
        r="52"
        fill="none"
        stroke="#E5E5E3"
        stroke-width="1"
      />
      <text
        x="160"
        y="154"
        text-anchor="middle"
        class="center-label"
        fill="#000000"
      >
        Continuous
      </text>
      <text
        x="160"
        y="168"
        text-anchor="middle"
        class="center-label"
        fill="#000000"
      >
        Data Loop
      </text>
      <text
        x="160"
        y="183"
        text-anchor="middle"
        class="center-sub"
        fill="#8A8A88"
      >
        AD INFRASTRUCTURE
      </text>

      <!-- ===== LAYER 4: Focus nodes (black, highlighted) ===== -->

      <!-- Trigger Mining (top-right) -->
      <g>
        <rect
          x="224"
          y="106"
          width="78"
          height="24"
          rx="3"
          fill="#000000"
          filter="url(#focus-glow)"
        />
        <text
          x="263"
          y="122"
          text-anchor="middle"
          class="node-label"
          fill="#FFFFFF"
        >
          Trigger Mining
        </text>
      </g>

      <!-- Scenario Replay (right) -->
      <g>
        <rect
          x="228"
          y="162"
          width="78"
          height="24"
          rx="3"
          fill="#000000"
          filter="url(#focus-glow)"
        />
        <text
          x="267"
          y="178"
          text-anchor="middle"
          class="node-label"
          fill="#FFFFFF"
        >
          Scenario Replay
        </text>
      </g>

      <!-- KPI Evaluation (bottom-right) -->
      <g>
        <rect
          x="208"
          y="232"
          width="78"
          height="24"
          rx="3"
          fill="#000000"
          filter="url(#focus-glow)"
        />
        <text
          x="247"
          y="248"
          text-anchor="middle"
          class="node-label"
          fill="#FFFFFF"
        >
          KPI Evaluation
        </text>
      </g>

      <!-- Regression Validation (bottom-left) -->
      <g>
        <rect
          x="36"
          y="232"
          width="92"
          height="24"
          rx="3"
          fill="#000000"
          filter="url(#focus-glow)"
        />
        <text
          x="82"
          y="248"
          text-anchor="middle"
          class="node-label"
          fill="#FFFFFF"
        >
          Regression Validation
        </text>
      </g>

      <!-- ===== LAYER 5: Context nodes (gray, upstream/downstream) ===== -->

      <!-- Vehicle Logs (top-left, upstream) -->
      <g>
        <rect
          x="72"
          y="80"
          width="72"
          height="22"
          rx="3"
          fill="none"
          stroke="#8A8A88"
          stroke-width="1"
        />
        <text
          x="108"
          y="95"
          text-anchor="middle"
          class="node-label"
          fill="#8A8A88"
        >
          Vehicle Logs
        </text>
        <text
          x="108"
          y="75"
          text-anchor="middle"
          style="font-family: 'IBM Plex Mono', monospace; font-size: 7px; letter-spacing: 0.08em;"
          fill="#AAAAAA"
        >
          UPSTREAM
        </text>
      </g>

      <!-- Scenario Library (left, downstream) -->
      <g>
        <rect
          x="40"
          y="162"
          width="80"
          height="22"
          rx="3"
          fill="none"
          stroke="#8A8A88"
          stroke-width="1"
        />
        <text
          x="80"
          y="177"
          text-anchor="middle"
          class="node-label"
          fill="#8A8A88"
        >
          Scenario Library
        </text>
        <text
          x="80"
          y="157"
          text-anchor="middle"
          style="font-family: 'IBM Plex Mono', monospace; font-size: 7px; letter-spacing: 0.08em;"
          fill="#AAAAAA"
        >
          DOWNSTREAM
        </text>
      </g>
    </svg>
  </div>
</div>

---
/**
 * ClosedLoopDiagram — Autonomous Driving Data Loop
 *
 * - Ring radius: 140 (scaled up ~17%)
 * - All nodes: consistent 100×26, outside the ring
 * - Center: title only, no subtitle
 * - Subtle data pulse
 */
---

<div class="w-full max-w-lg">
  <div class="relative" style="padding-bottom: 100%;">
    <svg
      viewBox="0 0 400 400"
      class="absolute inset-0 w-full h-full"
      xmlns="http://www.w3.org/2000/svg"
    >
      <style>
        .nl  { font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; font-weight: 500; letter-spacing: 0.02em; }
        .ct  { font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
      </style>

      <defs>
        <marker id="ab" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0.5 L 7.5 4 L 0 7.5 z" fill="#000" />
        </marker>
        <marker id="ag" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0.5 L 7.5 4 L 0 7.5 z" fill="#8A8A88" />
        </marker>
        <filter id="pg" x="-100%" y="-100%" width="300%" height="300%">
          <feGaussianBlur stdDeviation="2" result="b" />
          <feComposite in="SourceGraphic" in2="b" operator="over" />
        </filter>
      </defs>

      <!-- ═══ Ring ═══ -->
      <circle cx="200" cy="200" r="140" fill="none" stroke="#E5E5E3" stroke-width="1" />

      <!-- ═══ Focus arcs (solid black) ═══ -->

      <!-- Vehicle Logs → Trigger Mining -->
      <path d="M 226 64 A 140 140 0 0 1 336 158" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- Trigger Mining → Scenario Replay -->
      <path d="M 340 176 A 140 140 0 0 1 340 224" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- Scenario Replay → KPI Evaluation -->
      <path d="M 336 242 A 140 140 0 0 1 226 336" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- KPI Evaluation → Regression Validation -->
      <path d="M 214 340 A 140 140 0 0 1 186 340" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- ═══ Context arcs (dashed gray) ═══ -->

      <!-- Regression Validation → Scenario Library -->
      <path d="M 174 336 A 140 140 0 0 1 64 242" fill="none" stroke="#8A8A88" stroke-width="1" stroke-dasharray="5 4" marker-end="url(#ag)" />

      <!-- Scenario Library → Vehicle Logs -->
      <path d="M 60 158 A 140 140 0 0 1 174 64" fill="none" stroke="#8A8A88" stroke-width="1" stroke-dasharray="5 4" marker-end="url(#ag)" />

      <!-- ═══ Data pulse ═══ -->
      <circle r="2.5" fill="#000" filter="url(#pg)" opacity="0">
        <animateMotion dur="8s" repeatCount="indefinite" path="M 200 60 A 140 140 0 1 1 199.99 60" />
        <animate attributeName="opacity" values="0;1;1;1;0" keyTimes="0;0.06;0.5;0.88;1" dur="8s" repeatCount="indefinite" />
      </circle>
      <circle r="2" fill="#000" filter="url(#pg)" opacity="0">
        <animateMotion dur="8s" begin="4s" repeatCount="indefinite" path="M 200 60 A 140 140 0 1 1 199.99 60" />
        <animate attributeName="opacity" values="0;1;1;1;0" keyTimes="0;0.06;0.5;0.88;1" dur="8s" begin="4s" repeatCount="indefinite" />
      </circle>

      <!-- ═══ Center ═══ -->
      <circle cx="200" cy="200" r="48" fill="#FAFAF8" />
      <circle cx="200" cy="200" r="48" fill="none" stroke="#E5E5E3" stroke-width="0.75" />

      <text x="200" y="196" text-anchor="middle" class="ct" fill="#000">Autonomous Driving</text>
      <text x="200" y="212" text-anchor="middle" class="ct" fill="#000">Data Loop</text>

      <!-- ═══ Focus nodes (black, 100×26) ═══ -->

      <!-- Trigger Mining (top-right) -->
      <rect x="256" y="125" width="100" height="26" rx="3" fill="#000" />
      <text x="306" y="142" text-anchor="middle" class="nl" fill="#FFF">Trigger Mining</text>

      <!-- Scenario Replay (right) -->
      <rect x="260" y="210" width="100" height="26" rx="3" fill="#000" />
      <text x="310" y="227" text-anchor="middle" class="nl" fill="#FFF">Scenario Replay</text>

      <!-- KPI Evaluation (bottom-right) -->
      <rect x="236" y="315" width="100" height="26" rx="3" fill="#000" />
      <text x="286" y="332" text-anchor="middle" class="nl" fill="#FFF">KPI Evaluation</text>

      <!-- Regression Validation (bottom-left) -->
      <rect x="64" y="315" width="100" height="26" rx="3" fill="#000" />
      <text x="114" y="332" text-anchor="middle" class="nl" fill="#FFF">Regression Validation</text>

      <!-- ═══ Context nodes (white/gray, 100×26) ═══ -->

      <!-- Vehicle Logs (top-left) -->
      <rect x="44" y="125" width="100" height="26" rx="3" fill="#FAFAF8" stroke="#8A8A88" stroke-width="1" />
      <text x="94" y="142" text-anchor="middle" class="nl" fill="#666">Vehicle Logs</text>

      <!-- Scenario Library (left) -->
      <rect x="40" y="210" width="100" height="26" rx="3" fill="#FAFAF8" stroke="#8A8A88" stroke-width="1" />
      <text x="90" y="227" text-anchor="middle" class="nl" fill="#666">Scenario Library</text>

    </svg>
  </div>
</div>

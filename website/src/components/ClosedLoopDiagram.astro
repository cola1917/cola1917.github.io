---
/**
 * ClosedLoopDiagram — Autonomous Driving Data Loop
 *
 * - Ring radius: 150 (enlarged)
 * - No background/decorative rings
 * - All nodes: 100×26, outside the ring
 * - Center: title only
 * - Subtle data pulse
 */
---

<div class="w-full max-w-xl">
  <div class="relative" style="padding-bottom: 100%;">
    <svg
      viewBox="0 0 400 400"
      class="absolute inset-0 w-full h-full"
      xmlns="http://www.w3.org/2000/svg"
    >
      <style>
        .nl  { font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 500; letter-spacing: 0.01em; }
        .ct  { font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
      </style>

      <defs>
        <marker id="ab" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0.5 L 7.5 4 L 0 7.5 z" fill="#000" />
        </marker>
        <marker id="ag" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0.5 L 7.5 4 L 0 7.5 z" fill="#8A8A88" />
        </marker>
        <filter id="pg" x="-100%" y="-100%" width="300%" height="300%">
          <feGaussianBlur stdDeviation="2" result="b" />
          <feComposite in="SourceGraphic" in2="b" operator="over" />
        </filter>
      </defs>

      <!-- ═══ Focus arcs (solid black) ═══ -->

      <!-- Vehicle Logs → Trigger Mining -->
      <path d="M 224 54 A 150 150 0 0 1 345 146" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- Trigger Mining → Scenario Replay -->
      <path d="M 350 174 A 150 150 0 0 1 350 226" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- Scenario Replay → KPI Evaluation -->
      <path d="M 345 254 A 150 150 0 0 1 224 346" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- KPI Evaluation → Regression Validation -->
      <path d="M 212 350 A 150 150 0 0 1 188 350" fill="none" stroke="#000" stroke-width="2" marker-end="url(#ab)" />

      <!-- ═══ Context arcs (dashed gray) ═══ -->

      <!-- Regression Validation → Scenario Library -->
      <path d="M 176 346 A 150 150 0 0 1 55 254" fill="none" stroke="#8A8A88" stroke-width="1" stroke-dasharray="5 4" marker-end="url(#ag)" />

      <!-- Scenario Library → Vehicle Logs -->
      <path d="M 50 146 A 150 150 0 0 1 176 54" fill="none" stroke="#8A8A88" stroke-width="1" stroke-dasharray="5 4" marker-end="url(#ag)" />

      <!-- ═══ Data pulse ═══ -->
      <circle r="2.5" fill="#000" filter="url(#pg)" opacity="0">
        <animateMotion dur="8s" repeatCount="indefinite" path="M 200 50 A 150 150 0 1 1 199.99 50" />
        <animate attributeName="opacity" values="0;1;1;1;0" keyTimes="0;0.06;0.5;0.88;1" dur="8s" repeatCount="indefinite" />
      </circle>
      <circle r="2" fill="#000" filter="url(#pg)" opacity="0">
        <animateMotion dur="8s" begin="4s" repeatCount="indefinite" path="M 200 50 A 150 150 0 1 1 199.99 50" />
        <animate attributeName="opacity" values="0;1;1;1;0" keyTimes="0;0.06;0.5;0.88;1" dur="8s" begin="4s" repeatCount="indefinite" />
      </circle>

      <!-- ═══ Center ═══ -->
      <circle cx="200" cy="200" r="48" fill="#FAFAF8" />

      <text x="200" y="196" text-anchor="middle" class="ct" fill="#000">Autonomous Driving</text>
      <text x="200" y="212" text-anchor="middle" class="ct" fill="#000">Data Loop</text>

      <!-- ═══ Focus nodes (black, 140×30) ═══ -->

      <!-- Trigger Mining (top-right) -->
      <rect x="242" y="113" width="140" height="30" rx="4" fill="#000" />
      <text x="312" y="133" text-anchor="middle" class="nl" fill="#FFF">Trigger Mining</text>

      <!-- Scenario Replay (right) -->
      <rect x="248" y="208" width="140" height="30" rx="4" fill="#000" />
      <text x="318" y="228" text-anchor="middle" class="nl" fill="#FFF">Scenario Replay</text>

      <!-- KPI Evaluation (bottom-right) -->
      <rect x="220" y="323" width="140" height="30" rx="4" fill="#000" />
      <text x="290" y="343" text-anchor="middle" class="nl" fill="#FFF">KPI Evaluation</text>

      <!-- Regression Validation (bottom-left) -->
      <rect x="40" y="323" width="140" height="30" rx="4" fill="#000" />
      <text x="110" y="343" text-anchor="middle" class="nl" fill="#FFF">Regression Validation</text>

      <!-- ═══ Context nodes (white/gray, 140×30) ═══ -->

      <!-- Vehicle Logs (top-left) -->
      <rect x="18" y="113" width="140" height="30" rx="4" fill="#FAFAF8" stroke="#8A8A88" stroke-width="1" />
      <text x="88" y="133" text-anchor="middle" class="nl" fill="#666">Vehicle Logs</text>

      <!-- Scenario Library (left) -->
      <rect x="12" y="208" width="140" height="30" rx="4" fill="#FAFAF8" stroke="#8A8A88" stroke-width="1" />
      <text x="82" y="228" text-anchor="middle" class="nl" fill="#666">Scenario Library</text>

    </svg>
  </div>
</div>

---
interface Props {
  title: string;
  titleEn: string;
  description: string;
  techStack: string[];
  status?: string;
  period?: string;
}

const { title, titleEn, description, techStack, status, period } = Astro.props;
---

<section class="pt-14">
  <div class="max-w-4xl mx-auto px-6 py-16">
    <a href="/#projects" class="text-sm font-mono text-muted hover:text-black transition-colors">
      ← 返回项目列表
    </a>

    <div class="mt-8">
      <h1 class="text-3xl font-sans font-bold tracking-tight">{title}</h1>
      <p class="mt-2 text-base font-mono text-muted">{titleEn}</p>
    </div>

    <p class="mt-4 text-muted leading-relaxed max-w-2xl">{description}</p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      {status && (
        <span class="text-xs font-mono px-2 py-1 bg-black text-white rounded">
          {status}
        </span>
      )}
      {period && (
        <span class="text-xs font-mono text-muted">
          {period}
        </span>
      )}
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      {techStack.map((tag) => (
        <span class="text-xs font-mono px-2 py-1 bg-surface border border-border rounded text-muted">
          {tag}
        </span>
      ))}
    </div>
  </div>
</section>

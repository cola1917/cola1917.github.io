---
interface RoadmapItem {
  item: string;
  itemEn: string;
  priority?: 'high' | 'medium' | 'low';
}

interface Props {
  roadmap?: RoadmapItem[];
}

const { roadmap } = Astro.props;

const priorityColors = {
  high: 'bg-black',
  medium: 'bg-muted',
  low: 'bg-border',
};
---

<section id="future-roadmap">
  <h2 class="text-lg font-sans font-semibold border-b border-border pb-2">
    未来规划
  </h2>

  {roadmap && roadmap.length > 0 ? (
    <div class="mt-4 space-y-3">
      {roadmap.map((entry) => (
        <div class="flex items-start gap-3">
          <div class={`mt-1.5 w-2 h-2 rounded-full flex-shrink-0 ${priorityColors[entry.priority || 'medium']}`} />
          <div>
            <p class="text-sm text-muted leading-relaxed">{entry.item}</p>
            <p class="text-xs font-mono text-muted">{entry.itemEn}</p>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="mt-4 text-sm font-mono text-muted">规划中...</p>
  )}
</section>

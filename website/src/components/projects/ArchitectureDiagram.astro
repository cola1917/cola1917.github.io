---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-6">
  {src ? (
    <div class="p-4 bg-surface border border-border rounded">
      <img src={src} alt={alt} class="w-full h-auto" loading="lazy" />
    </div>
  ) : (
    <div class="p-8 bg-surface border border-border rounded flex items-center justify-center">
      <p class="text-sm font-mono text-muted">架构图待添加</p>
    </div>
  )}
  {caption && (
    <figcaption class="mt-2 text-xs font-mono text-muted text-center">
      {caption}
    </figcaption>
  )}
</figure>

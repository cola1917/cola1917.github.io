---
interface Highlight {
  metric: string;
  label: string;
  labelEn: string;
}

interface Props {
  highlights?: Highlight[];
}

const { highlights } = Astro.props;
---

{highlights && highlights.length > 0 && (
  <section id="technical-highlights">
    <h2 class="text-lg font-sans font-semibold border-b border-border pb-2">
      技术亮点
    </h2>

    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {highlights.map((highlight) => (
        <div class="p-4 bg-surface border border-border rounded">
          <p class="text-2xl font-mono font-bold">{highlight.metric}</p>
          <p class="mt-1 text-sm text-muted">{highlight.label}</p>
          <p class="text-xs font-mono text-muted">{highlight.labelEn}</p>
        </div>
      ))}
    </div>
  </section>
)}

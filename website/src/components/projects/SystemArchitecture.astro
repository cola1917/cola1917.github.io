---
interface Props {
  showDiagramSlot?: boolean;
}

const { showDiagramSlot = false } = Astro.props;
---

<section id="system-architecture">
  <h2 class="text-lg font-sans font-semibold border-b border-border pb-2">
    系统架构
  </h2>

  {showDiagramSlot && (
    <div class="mt-4 p-4 bg-surface border border-border rounded">
      <slot name="diagram" />
    </div>
  )}

  <div class="mt-4 prose-arch">
    <slot />
  </div>
</section>

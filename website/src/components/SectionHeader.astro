---
import type { Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  level?: 'h1' | 'h2';
  locale?: Locale;
}

const {
  title,
  description,
  href,
  level = 'h2',
  locale = 'zh',
} = Astro.props;
const linkLabel = Astro.props.linkLabel ?? (locale === 'zh' ? '查看全部 →' : 'View all →');
const Heading = level;
---

<div class="section-heading">
  <Heading>{title}</Heading>
  <div class="section-heading-aside">
    {description && <p class="section-heading-description">{description}</p>}
    {href && <a class="section-link" href={href}>{linkLabel}</a>}
  </div>
</div>

---
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  level?: 'h1' | 'h2';
}

const {
  title,
  description,
  href,
  linkLabel = 'View all →',
  level = 'h2',
} = Astro.props;
const Heading = level;
---

<div class="section-heading">
  <Heading>{title}</Heading>
  <div class="section-heading-aside">
    {description && <p class="section-heading-description">{description}</p>}
    {href && <a class="section-link" href={href}>{linkLabel}</a>}
  </div>
</div>

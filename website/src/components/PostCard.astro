---
import type { CollectionEntry } from 'astro:content';
import { formatDate, slugify } from '../lib/content';
import { contentSlug, localizedPath, type Locale } from '../lib/i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  locale?: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { post, locale = post.data.locale, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="card">
  <a class="card-link" href={localizedPath(locale, `/blog/${contentSlug(post.id)}/`)}>
    <div class="card-meta">
      <span>{formatDate(post.data.publishedAt, locale)}</span>
    </div>
    <Heading class="card-title">{post.data.title}</Heading>
    <p class="card-copy">{post.data.description}</p>
    <div class="card-foot">
      {post.data.tags.slice(0, 3).map((tag) => <span class="tag">#{slugify(tag)}</span>)}
    </div>
  </a>
</article>

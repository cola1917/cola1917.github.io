---
import type { CollectionEntry } from 'astro:content';
import { categoryLabels } from '../data/site';
import { formatDate, slugify } from '../lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="card">
  <a class="card-link" href={`/blog/${post.id}/`}>
    <div class="card-meta">
      <span>{formatDate(post.data.publishedAt)}</span>
      <span aria-hidden="true">/</span>
      <span>{categoryLabels[post.data.category]}</span>
    </div>
    <h3 class="card-title">{post.data.title}</h3>
    <p class="card-copy">{post.data.description}</p>
    <div class="card-foot">
      {post.data.tags.slice(0, 3).map((tag) => <span class="tag">#{slugify(tag)}</span>)}
    </div>
  </a>
</article>

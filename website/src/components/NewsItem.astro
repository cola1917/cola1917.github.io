---
import type { CollectionEntry } from 'astro:content';
import { newsTypeLabels } from '../data/site';
import { formatDate } from '../lib/content';
import { localizedPath, type Locale } from '../lib/i18n';

interface Props {
  item: CollectionEntry<'news'>;
  locale?: Locale;
}

const { item, locale = item.data.locale } = Astro.props;
const link = item.data.link ? localizedPath(locale, item.data.link) : undefined;
---

{
  link ? (
    <a class="list-row" href={link}>
      <span class="list-kicker">{formatDate(item.data.date, locale)}</span>
      <span class="list-content">
        <strong class="list-title">{item.data.title}</strong>
        <span class="list-summary">{item.data.summary}</span>
      </span>
      <span class="status">{newsTypeLabels[locale][item.data.type]}</span>
    </a>
  ) : (
    <div class="list-row">
      <span class="list-kicker">{formatDate(item.data.date, locale)}</span>
      <span class="list-content">
        <strong class="list-title">{item.data.title}</strong>
        <span class="list-summary">{item.data.summary}</span>
      </span>
      <span class="status">{newsTypeLabels[locale][item.data.type]}</span>
    </div>
  )
}
